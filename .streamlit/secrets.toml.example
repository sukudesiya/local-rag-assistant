# Copy these into Streamlit Community Cloud: App settings > Secrets.
# Never commit a real key to GitHub.
HOSTED_API_KEY = "paste-your-gemini-api-key-here"

# Optional. These are the defaults; change them if the provider renames a model.
HOSTED_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
HOSTED_EMBED_MODEL = "gemini-embedding-001"
HOSTED_CHAT_MODEL = "gemini-2.5-flash"